# Copy to config/.env for Python local runs. Never commit real keys.
# Model, endpoint and default provider: config/api.json.
GEMINI_API_KEY=
# Paid provider, disabled by default. Leave unset for free-only usage.
# DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PRODUCTHUNT_TOKEN=

# Optional Cloudflare KV access for interactive Telegram context.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# Only disables Telegram delivery; local state and KV may still be written.
DRY_RUN=true

# Optional overrides (leave commented to use api.json).
# LLM_ENGINE=gemini
# LLM_TEMPERATURE=0.2
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_ENDPOINT=
# DEEPSEEK_MODEL=
# DEEPSEEK_ENDPOINT=
